{
  "name": "paperrune-documentation",
  "private": true,
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:wasm": "bash tools/build-docs-wasm.sh",
    "docs:build": "npm run docs:wasm && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:unit": "node tools/test-playground-wasm-runtime.mjs && node tools/test-playground-studio-model.mjs",
    "docs:check": "npm run docs:unit && npm run docs:build && node tools/test-docs-wasm.mjs docs/.vitepress/dist"
  },
  "devDependencies": {
    "vitepress": "2.0.0-alpha.18",
    "vue": "3.5.40"
  },
  "engines": {
    "node": ">=20"
  }
}
