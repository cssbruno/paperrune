document @catalog:
  title: "PaperRune built-in tool catalog"
  language: "en"
  page @a4:
    size: "A4"
    margin: 28pt
    page-numbers: true
    page-number-format: "PaperRune tools | Page %d of {pages}"
    page-total-alias: "{pages}"
    page-number-position: "footer"
    page-number-align: "outer"
    page-number-hide-first: true
    header @header:
      paragraph @header-copy:
        size: 8pt
        bold: true
        color: "#2C6E7F"
        text: "PAPERRUNE | CURATED BUILT-IN TOOLS"
    footer @footer:
      paragraph @footer-copy:
        size: 8pt
        align: "center"
        color: "#64748B"
        text: "Editable Paper structures - generated from the production palette"
    body @body:
      heading @catalog-title:
        level: 1
        size: 30pt
        color: "#163A46"
        text: "Built-in tool catalog"
      paragraph @catalog-intro:
        size: 11pt
        line-height: 14pt
        color: "#475569"
        text: "A visual inventory of the curated programmatic palette. Every example below is generated by the same backend template used by Paper Studio."
      paragraph @catalog-note:
        size: 9pt
        padding: 12pt
        background: "#EAF4F7"
        border-left-width: 3pt
        border-color: "#2C6E7F"
        text: "Curation rule: keep distinct document structures; use styles and themes for cosmetic variants."
      page-break @catalog-cover-break:
      heading @group-a-title:
        level: 1
        size: 24pt
        color: "#163A46"
        text: "Structure"
      paragraph @group-a-intro:
        size: 9pt
        line-height: 12pt
        color: "#64748B"
        text: "Page and section structures that establish hierarchy without hiding ordinary Paper nodes."
      heading @group-a-tool-a-label:
        level: 2
        margin-top: 18pt
        size: 14pt
        color: "#2C6E7F"
        text: "title-block"
      paragraph @group-a-tool-a-description:
        size: 8pt
        line-height: 11pt
        color: "#64748B"
        text: "In-body title and subtitle hierarchy."
      table @group-a-tool-a-preview:
        split: "avoid"
        table-row @group-a-tool-a-preview-eyebrow-row:
          cell @group-a-tool-a-preview-eyebrow:
            text: "DOCUMENT"
            size: 8pt
            bold: true
            color: "#2C6E7F"
            padding-bottom: 4pt
        table-row @group-a-tool-a-preview-title-row:
          cell @group-a-tool-a-preview-title:
            text: "Document title"
            size: 26pt
            bold: true
            color: "#163A46"
        table-row @group-a-tool-a-preview-subtitle-row:
          cell @group-a-tool-a-preview-subtitle:
            text: "Add a concise subtitle or document description."
            size: 11pt
            line-height: 15pt
            color: "#64748B"
            padding-bottom: 10pt
            border-bottom-width: 1.5pt
            border-color: "#2C6E7F"
      heading @group-a-tool-b-label:
        level: 2
        margin-top: 18pt
        size: 14pt
        color: "#2C6E7F"
        text: "cover-block"
      paragraph @group-a-tool-b-description:
        size: 8pt
        line-height: 11pt
        color: "#64748B"
        text: "Centered cover-page identity and metadata."
      column @group-a-tool-b-preview:
        gap: 10pt
        paragraph @group-a-tool-b-preview-eyebrow:
          size: 9pt
          bold: true
          align: "center"
          color: "#2C6E7F"
          text: "PAPERRUNE | DOCUMENT"
        heading @group-a-tool-b-preview-title:
          level: 1
          size: 32pt
          align: "center"
          color: "#163A46"
          text: "Document title"
        paragraph @group-a-tool-b-preview-subtitle:
          size: 13pt
          line-height: 18pt
          align: "center"
          color: "#334155"
          text: "Document subtitle or purpose"
        paragraph @group-a-tool-b-preview-metadata:
          size: 9pt
          align: "center"
          color: "#64748B"
          text: "Author | organization | date"
      heading @group-a-tool-c-label:
        level: 2
        margin-top: 18pt
        size: 14pt
        color: "#2C6E7F"
        text: "two-column"
      paragraph @group-a-tool-c-description:
        size: 8pt
        line-height: 11pt
        color: "#64748B"
        text: "Balanced editorial columns with explicit headings."
      table @group-a-tool-c-preview:
        split: "avoid"
        table-column @group-a-tool-c-preview-left-column:
          width: 50%
        table-column @group-a-tool-c-preview-right-column:
          width: 50%
        table-header @group-a-tool-c-preview-head:
          table-row @group-a-tool-c-preview-head-row:
            cell @group-a-tool-c-preview-left-heading:
              text: "FIRST COLUMN"
              padding: 7pt
              color: "#FFFFFF"
              border-width: 0.5pt
              border-color: "#D5E2E6"
              bold: true
              background: "#1F5967"
            cell @group-a-tool-c-preview-right-heading:
              text: "SECOND COLUMN"
              padding: 7pt
              color: "#FFFFFF"
              border-width: 0.5pt
              border-color: "#D5E2E6"
              bold: true
              background: "#1F5967"
        table-row @group-a-tool-c-preview-body-row:
          cell @group-a-tool-c-preview-left-copy:
            text: "Add focused content for the first column."
            padding: 7pt
            color: "#334155"
            border-width: 0.5pt
            border-color: "#D5E2E6"
            background: "#F7FAFB"
          cell @group-a-tool-c-preview-right-copy:
            text: "Add focused content for the second column."
            padding: 7pt
            color: "#334155"
            border-width: 0.5pt
            border-color: "#D5E2E6"
      heading @group-a-tool-d-label:
        level: 2
        margin-top: 18pt
        size: 14pt
        color: "#2C6E7F"
        text: "divider"
      paragraph @group-a-tool-d-description:
        size: 8pt
        line-height: 11pt
        color: "#64748B"
        text: "Lightweight visual section boundary."
      paragraph @group-a-tool-d-preview:
        text: " "
        size: 1pt
        line-height: 5pt
        border-bottom-width: 1pt
        border-color: "#2C6E7F"
      heading @group-b-title:
        level: 1
        size: 24pt
        color: "#163A46"
        text: "Communication"
      paragraph @group-b-intro:
        size: 9pt
        line-height: 12pt
        color: "#64748B"
        text: "Purpose-specific emphasis patterns; cosmetic variants remain styles rather than separate tools."
      heading @group-b-tool-a-label:
        level: 2
        margin-top: 18pt
        size: 14pt
        color: "#2C6E7F"
        text: "note-box"
      paragraph @group-b-tool-a-description:
        size: 8pt
        line-height: 11pt
        color: "#64748B"
        text: "Neutral supporting information."
      paragraph @group-b-tool-a-preview:
        text: "NOTE\nAdd the supporting detail readers should not miss."
        bold: true
        line-height: 15pt
        color: "#163A46"
        padding: 12pt
        background: "#EAF4F7"
        border-left-width: 4pt
        border-color: "#2C6E7F"
      heading @group-b-tool-b-label:
        level: 2
        margin-top: 18pt
        size: 14pt
        color: "#2C6E7F"
        text: "quote"
      paragraph @group-b-tool-b-description:
        size: 8pt
        line-height: 11pt
        color: "#64748B"
        text: "Quoted or highlighted statement."
      paragraph @group-b-tool-b-preview:
        text: "\"Add a meaningful quotation or highlighted statement here.\"\n- Source or role"
        italic: true
        size: 12pt
        line-height: 17pt
        color: "#163A46"
        padding: 14pt
        background: "#F7FAFB"
        border-left-width: 4pt
        border-color: "#2C6E7F"
      heading @group-b-tool-c-label:
        level: 2
        margin-top: 18pt
        size: 14pt
        color: "#2C6E7F"
        text: "status-banner"
      paragraph @group-b-tool-c-description:
        size: 8pt
        line-height: 11pt
        color: "#64748B"
        text: "Compact workflow or document status."
      paragraph @group-b-tool-c-preview:
        text: "APPROVED | Ready for release"
        bold: true
        size: 10pt
        color: "#177245"
        padding: 9pt
        background: "#E8F7EF"
        border-left-width: 4pt
        border-color: "#177245"
      heading @group-b-tool-d-label:
        level: 2
        margin-top: 18pt
        size: 14pt
        color: "#2C6E7F"
        text: "disclaimer"
      paragraph @group-b-tool-d-description:
        size: 8pt
        line-height: 11pt
        color: "#64748B"
        text: "Small-print notice or limitation."
      paragraph @group-b-tool-d-preview:
        text: "NOTICE | Replace this text with the applicable limitation, disclosure, or legal disclaimer."
        size: 8pt
        line-height: 12pt
        color: "#64748B"
        padding: 9pt
        background: "#FFF4CF"
        border-left-width: 3pt
        border-color: "#9A6700"
      heading @group-b-tool-e-label:
        level: 2
        margin-top: 18pt
        size: 14pt
        color: "#2C6E7F"
        text: "faq-block"
      paragraph @group-b-tool-e-description:
        size: 8pt
        line-height: 11pt
        color: "#64748B"
        text: "Two editable question-and-answer pairs."
      table @group-b-tool-e-preview:
        split: "avoid"
        table-row @group-b-tool-e-preview-one-question-row:
          cell @group-b-tool-e-preview-one-question:
            text: "Q1 | What is the first common question?"
            bold: true
            color: "#FFFFFF"
            background: "#1F5967"
            padding: 8pt
        table-row @group-b-tool-e-preview-one-answer-row:
          cell @group-b-tool-e-preview-one-answer:
            text: "Provide a direct, concise answer with the essential details."
            padding: 9pt
            color: "#334155"
            background: "#F7FAFB"
            border-left-width: 3pt
            border-color: "#2C6E7F"
        table-row @group-b-tool-e-preview-two-question-row:
          cell @group-b-tool-e-preview-two-question:
            text: "Q2 | What else should readers know?"
            bold: true
            color: "#FFFFFF"
            background: "#1F5967"
            padding: 8pt
        table-row @group-b-tool-e-preview-two-answer-row:
          cell @group-b-tool-e-preview-two-answer:
            text: "Add the second answer or remove this pair when unnecessary."
            padding: 9pt
            color: "#334155"
            background: "#F7FAFB"
            border-left-width: 3pt
            border-color: "#2C6E7F"
      page-break @actions-section-break:
      heading @group-c-title:
        level: 1
        size: 24pt
        color: "#163A46"
        text: "Actions and decisions"
      paragraph @group-c-intro:
        size: 9pt
        line-height: 12pt
        color: "#64748B"
        text: "Operational structures for tasks, approvals, signatures, and durable decision context."
      heading @group-c-tool-a-label:
        level: 2
        margin-top: 18pt
        size: 14pt
        color: "#2C6E7F"
        text: "checklist"
      paragraph @group-c-tool-a-description:
        size: 8pt
        line-height: 11pt
        color: "#64748B"
        text: "Editable task rows with quiet, outlined check controls."
      table @group-c-tool-a-preview:
        split: "avoid"
        table-column @group-c-tool-a-preview-check-column:
          width: 5%
        table-column @group-c-tool-a-preview-task-column:
          width: 95%
        table-row @group-c-tool-a-preview-row-one:
          cell @group-c-tool-a-preview-check-one:
            text: " "
            size: 1pt
            line-height: 1pt
            padding: 7pt
            border-width: 1.25pt
            border-color: "#2C6E7F"
            background: "#FFFFFF"
          cell @group-c-tool-a-preview-task-one:
            text: "Confirm scope and owner"
            size: 10pt
            line-height: 14pt
            padding-top: 7pt
            padding-right: 8pt
            padding-bottom: 7pt
            padding-left: 12pt
            color: "#334155"
            border-bottom-width: 0.5pt
            border-color: "#D5E2E6"
        table-row @group-c-tool-a-preview-row-two:
          cell @group-c-tool-a-preview-check-two:
            text: " "
            size: 1pt
            line-height: 1pt
            padding: 7pt
            border-width: 1.25pt
            border-color: "#2C6E7F"
            background: "#FFFFFF"
          cell @group-c-tool-a-preview-task-two:
            text: "Review supporting details"
            size: 10pt
            line-height: 14pt
            padding-top: 7pt
            padding-right: 8pt
            padding-bottom: 7pt
            padding-left: 12pt
            color: "#334155"
            border-bottom-width: 0.5pt
            border-color: "#D5E2E6"
        table-row @group-c-tool-a-preview-row-three:
          cell @group-c-tool-a-preview-check-three:
            text: " "
            size: 1pt
            line-height: 1pt
            padding: 7pt
            border-width: 1.25pt
            border-color: "#2C6E7F"
            background: "#FFFFFF"
          cell @group-c-tool-a-preview-task-three:
            text: "Record completion and sign-off"
            size: 10pt
            line-height: 14pt
            padding-top: 7pt
            padding-right: 8pt
            padding-bottom: 7pt
            padding-left: 12pt
            color: "#334155"
            border-bottom-width: 0.5pt
            border-color: "#D5E2E6"
      heading @group-c-tool-b-label:
        level: 2
        margin-top: 18pt
        size: 14pt
        color: "#2C6E7F"
        text: "numbered-steps"
      paragraph @group-c-tool-b-description:
        size: 8pt
        line-height: 11pt
        color: "#64748B"
        text: "Ordered procedure or workflow."
      table @group-c-tool-b-preview:
        split: "rows"
        table-column @group-c-tool-b-preview-number-column:
          width: 9%
        table-column @group-c-tool-b-preview-step-column:
          width: 91%
        table-row @group-c-tool-b-preview-row-one:
          keep-with-next: true
          cell @group-c-tool-b-preview-number-one:
            text: "1"
            padding: 7pt
            color: "#FFFFFF"
            border-width: 0.5pt
            border-color: "#D5E2E6"
            align: "center"
            bold: true
            background: "#1F5967"
          cell @group-c-tool-b-preview-step-one:
            text: "Describe the first step."
            padding: 7pt
            color: "#334155"
            border-width: 0.5pt
            border-color: "#D5E2E6"
            bold: true
        table-row @group-c-tool-b-preview-row-two:
          keep-with-next: true
          cell @group-c-tool-b-preview-number-two:
            text: "2"
            padding: 7pt
            color: "#FFFFFF"
            border-width: 0.5pt
            border-color: "#D5E2E6"
            align: "center"
            bold: true
            background: "#2C6E7F"
          cell @group-c-tool-b-preview-step-two:
            text: "Describe the second step."
            padding: 7pt
            color: "#334155"
            border-width: 0.5pt
            border-color: "#D5E2E6"
        table-row @group-c-tool-b-preview-row-three:
          cell @group-c-tool-b-preview-number-three:
            text: "3"
            padding: 7pt
            color: "#FFFFFF"
            border-width: 0.5pt
            border-color: "#D5E2E6"
            align: "center"
            bold: true
            background: "#4F8794"
          cell @group-c-tool-b-preview-step-three:
            text: "Describe the final step."
            padding: 7pt
            color: "#334155"
            border-width: 0.5pt
            border-color: "#D5E2E6"
      heading @group-c-tool-c-label:
        level: 2
        margin-top: 18pt
        size: 14pt
        color: "#2C6E7F"
        text: "decision-record"
      paragraph @group-c-tool-c-description:
        size: 8pt
        line-height: 11pt
        color: "#64748B"
        text: "Context, decision, and consequences."
      table @group-c-tool-c-preview:
        split: "avoid"
        table-row @group-c-tool-c-preview-title-row:
          cell @group-c-tool-c-preview-title:
            text: "Decision record"
            bold: true
            size: 14pt
            color: "#FFFFFF"
            background: "#163A46"
            padding: 9pt
        table-row @group-c-tool-c-preview-context-label-row:
          cell @group-c-tool-c-preview-context-label:
            text: "CONTEXT"
            bold: true
            size: 8pt
            color: "#1F5967"
            background: "#EAF4F7"
            padding: 7pt
            border-left-width: 3pt
            border-color: "#2C6E7F"
        table-row @group-c-tool-c-preview-context-copy-row:
          cell @group-c-tool-c-preview-context-copy:
            text: "Describe the problem, constraints, and relevant evidence."
            padding: 9pt
            color: "#334155"
            background: "#F7FAFB"
        table-row @group-c-tool-c-preview-decision-label-row:
          cell @group-c-tool-c-preview-decision-label:
            text: "DECISION"
            bold: true
            size: 8pt
            color: "#1F5967"
            background: "#EAF4F7"
            padding: 7pt
            border-left-width: 3pt
            border-color: "#2C6E7F"
        table-row @group-c-tool-c-preview-decision-copy-row:
          cell @group-c-tool-c-preview-decision-copy:
            text: "State the chosen direction and why it was selected."
            padding: 9pt
            color: "#334155"
            background: "#F7FAFB"
        table-row @group-c-tool-c-preview-consequences-label-row:
          cell @group-c-tool-c-preview-consequences-label:
            text: "CONSEQUENCES"
            bold: true
            size: 8pt
            color: "#1F5967"
            background: "#EAF4F7"
            padding: 7pt
            border-left-width: 3pt
            border-color: "#2C6E7F"
        table-row @group-c-tool-c-preview-consequences-copy-row:
          cell @group-c-tool-c-preview-consequences-copy:
            text: "Record expected benefits, costs, and follow-up work."
            padding: 9pt
            color: "#334155"
            background: "#F7FAFB"
      heading @group-c-tool-d-label:
        level: 2
        margin-top: 18pt
        size: 14pt
        color: "#2C6E7F"
        text: "approval-block"
      paragraph @group-c-tool-d-description:
        size: 8pt
        line-height: 11pt
        color: "#64748B"
        text: "Reviewer and approver metadata."
      table @group-c-tool-d-preview:
        split: "avoid"
        table-column @group-c-tool-d-preview-label-column:
          width: 30%
        table-column @group-c-tool-d-preview-value-column:
          width: 70%
        table-row @group-c-tool-d-preview-review-row:
          cell @group-c-tool-d-preview-review-label:
            text: "REVIEWED"
            padding: 7pt
            color: "#1F5967"
            border-width: 0.5pt
            border-color: "#D5E2E6"
            bold: true
            background: "#EAF4F7"
          cell @group-c-tool-d-preview-review-value:
            text: "Name | role | date"
            padding: 7pt
            color: "#334155"
            border-width: 0.5pt
            border-color: "#D5E2E6"
        table-row @group-c-tool-d-preview-approval-row:
          cell @group-c-tool-d-preview-approval-label:
            text: "APPROVED"
            padding: 7pt
            color: "#177245"
            border-width: 0.5pt
            border-color: "#D5E2E6"
            bold: true
            background: "#E8F7EF"
          cell @group-c-tool-d-preview-approval-value:
            text: "Name | role | date"
            padding: 7pt
            color: "#334155"
            border-width: 0.5pt
            border-color: "#D5E2E6"
            bold: true
      heading @group-c-tool-e-label:
        level: 2
        margin-top: 18pt
        size: 14pt
        color: "#2C6E7F"
        text: "signature-row"
      paragraph @group-c-tool-e-description:
        size: 8pt
        line-height: 11pt
        color: "#64748B"
        text: "Signature and date lines."
      table @group-c-tool-e-preview:
        split: "avoid"
        table-column @group-c-tool-e-preview-signature-column:
          width: 62%
        table-column @group-c-tool-e-preview-date-column:
          width: 38%
        table-row @group-c-tool-e-preview-row:
          cell @group-c-tool-e-preview-signer:
            text: "Authorized signature"
            padding-top: 15pt
            padding-right: 16pt
            border-top-width: 0.75pt
            border-color: "#2C6E7F"
            color: "#64748B"
          cell @group-c-tool-e-preview-date:
            text: "Date"
            padding-top: 15pt
            padding-left: 16pt
            border-top-width: 0.75pt
            border-color: "#2C6E7F"
            color: "#64748B"
      page-break @reports-section-break:
      heading @group-d-title:
        level: 1
        size: 24pt
        color: "#163A46"
        text: "Reports and evidence"
      paragraph @group-d-intro:
        size: 9pt
        line-height: 12pt
        color: "#64748B"
        text: "Structured evidence patterns for summaries, comparisons, risks, revisions, and navigation."
      heading @group-d-tool-a-label:
        level: 2
        margin-top: 18pt
        size: 14pt
        color: "#2C6E7F"
        text: "kpi-strip"
      paragraph @group-d-tool-a-description:
        size: 8pt
        line-height: 11pt
        color: "#64748B"
        text: "Three high-level report metrics."
      table @group-d-tool-a-preview:
        split: "avoid"
        table-column @group-d-tool-a-preview-metric-one-column:
          width: 34%
        table-column @group-d-tool-a-preview-metric-two-column:
          width: 33%
        table-column @group-d-tool-a-preview-metric-three-column:
          width: 33%
        table-row @group-d-tool-a-preview-row:
          cell @group-d-tool-a-preview-metric-one:
            text: "42\nACTIVE"
            padding: 11pt
            color: "#FFFFFF"
            border-width: 0.5pt
            border-color: "#D5E2E6"
            size: 13pt
            line-height: 15pt
            bold: true
            align: "center"
            background: "#1F5967"
          cell @group-d-tool-a-preview-metric-two:
            text: "98%\nSUCCESS"
            padding: 11pt
            color: "#FFFFFF"
            border-width: 0.5pt
            border-color: "#D5E2E6"
            size: 13pt
            line-height: 15pt
            bold: true
            align: "center"
            background: "#2C6E7F"
          cell @group-d-tool-a-preview-metric-three:
            text: "12 d\nCYCLE"
            padding: 11pt
            color: "#FFFFFF"
            border-width: 0.5pt
            border-color: "#D5E2E6"
            size: 13pt
            line-height: 15pt
            bold: true
            align: "center"
            background: "#4F8794"
      heading @group-d-tool-b-label:
        level: 2
        margin-top: 18pt
        size: 14pt
        color: "#2C6E7F"
        text: "timeline"
      paragraph @group-d-tool-b-description:
        size: 8pt
        line-height: 11pt
        color: "#64748B"
        text: "Dated project or event milestones."
      table @group-d-tool-b-preview:
        split: "avoid"
        table-column @group-d-tool-b-preview-date-column:
          width: 24%
        table-column @group-d-tool-b-preview-milestone-column:
          width: 76%
        table-header @group-d-tool-b-preview-head:
          table-row @group-d-tool-b-preview-head-row:
            cell @group-d-tool-b-preview-head-date:
              text: "DATE"
              padding: 7pt
